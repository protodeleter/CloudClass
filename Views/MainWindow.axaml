<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AvaloniaApplication1.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="AvaloniaApplication1.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="AvaloniaApplication1"
        
        >

    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainViewModel />
    </Design.DataContext>

        
    <Grid 
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        ColumnSpacing="12"
        >

        
        
        
        <TabbedPage 
                    TabPlacement="Auto"
                    MinWidth="500"
                    Padding="0 50 0 0"
                    MinHeight="500"
                    >

            <ContentPage 
                Header="Home"
                Margin="0 50 0 0">
                
                <StackPanel Spacing="15">
                    <TextBox Text="{Binding DatabaseName, Mode=TwoWay}"
                             PlaceholderText="DB name" 
                             />

                    <TextBox Text="{Binding ContainerName, Mode=TwoWay}"
                             PlaceholderText="Container name" />
        
                    <Button Content="Show Values"
                            Command="{Binding ShowValuesCommand}" />
                    </StackPanel>
            </ContentPage>
            <ContentPage 
                Header="Create Container"
                Margin="0 50 0 0"></ContentPage>
            
            
        </TabbedPage>
        

    </Grid>
    
        
</Window>

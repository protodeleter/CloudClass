<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="AvaloniaApplication1.Views.MainWindow"
        Title="Cosmos DB Manager"
        Width="600"
        Height="400">

    <StackPanel Spacing="12"
                Margin="20">

        
        <TabControl Margin="5">
            <TabItem Header="Db Manager">
                <StackPanel>
                    
                <TextBlock Text="Database Manager"
                           FontSize="24"
                           FontWeight="Bold"
                           Margin="0 0 0 15"
                           />

                <TextBox x:Name="DatabaseNameTextBox"
                         PlaceholderText="Database Name"
                         Margin="0 0 0 15"
                         />

                <TextBox x:Name="ContainerNameTextBox"
                         PlaceholderText="Container Name"
                         Margin="0 0 0 15"
                         />

                <Button x:Name="CreateButton"
                        Content="Create Database"
                        Click="CreateDatabase_Click"/>

                <TextBlock x:Name="StatusText"
                           Text="Ready"
                           TextWrapping="Wrap"/>
                </StackPanel>

            </TabItem>
            
            <TabItem Header="All databases">
                <StackPanel>
                    
                    <ListBox x:Name="DatabasesList"
                             Height="250" 
                             />
                    
                    <TextBlock Margin="5">This is tab 2 content</TextBlock>
                
                </StackPanel>
                
            </TabItem>
        </TabControl>
        

    </StackPanel>
</Window>